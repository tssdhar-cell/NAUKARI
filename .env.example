# Copy to .env.local for local development and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Supabase project URL (Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase SECRET key (server-only, never exposed to the browser)
SUPABASE_SECRET_KEY=

# Single-user login for the app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random string, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Timezone used for "today" / overdue calculations
APP_TIMEZONE=Asia/Kolkata

# LOCAL ONLY (not needed on Vercel): used by `npm run db:push` to apply migrations.
# Supabase → Connect → Connection String → Session pooler. URL-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
